---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdUnit from '../components/AdUnit.astro';
import ListingCard from '../components/ListingCard.astro';
import { DEFAULT_CATEGORY } from '../utils';

import listings from '../data/listings.json';

const cities = [...new Set(listings.map(l => l.city))].sort();
const categories = [
  { slug: 'car', name: 'Location de Voitures', emoji: '🚗', href: '/car' },
  { slug: 'realestate', name: 'Immobilier', emoji: '🏢', href: '/realestate' },
  { slug: 'medical', name: 'Santé / Clinique', emoji: '🩺', href: '/medical' },
];

const latest = listings.slice(0, 6);
---

<Layout
  title="Atlas Directory — Trouvez l'annonce parfaite au Maroc"
  description="Plateforme de recherche d'annonces pour la location de voitures, l'immobilier et les services de santé à Casablanca, Rabat, Marrakech, Tanger et Agadir."
  keywords="annonces Maroc, location voiture, immobilier, clinique, santé, directory, programmatic SEO, Casablanca, Rabat, Marrakech, Tanger, Agadir"
>
  <Header siteTitle="Atlas Directory" siteTagline="Programmatic Directory & Aggregator · Multi-niche Listings" />

  <main class="flex-1">
    <!-- Hero -->
    <section class="relative bg-card border-b border-line overflow-hidden">
      <!-- Background subtle -->
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(circle at 10% 20%, rgba(228,161,27,0.15) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(18,140,126,0.12) 0%, transparent 40%);"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
        <div class="max-w-2xl">
          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-in" style="font-family:var(--font-display)">
            Trouvez l'annonce<br />
            <span class="text-accent" style="color:var(--accent)">parfaite au Maroc</span>
          </h1>
          <p class="mt-4 text-base sm:text-lg text-mute leading-relaxed max-w-xl">
            Location de voitures, immobilier, cliniques et services de santé.
            Annonces vérifiées, actualisées et classées par ville.
          </p>
        </div>
      </div>
    </section>

    <!-- ATF Ad: CLS-safe reserved space -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <AdUnit adSize="atf" />
    </div>

    <!-- Categories grid -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-xl font-semibold text-in" style="font-family:var(--font-display)">Par catégorie</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {categories.map(cat => (
          <a href={cat.href} class="group bg-card border border-line rounded-2xl p-6 hover:border-hot/40 transition-colors no-underline text-in block">
            <div class="text-3xl mb-3">{cat.emoji}</div>
            <h3 class="font-display text-base font-semibold group-hover:text-hot transition-colors" style="font-family:var(--font-display)">{cat.name}</h3>
            <p class="text-xs text-mute mt-1">
              Voir toutes les villes
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Latest listings -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-xl font-semibold text-in" style="font-family:var(--font-display)">Dernières annonces</h2>
        <a href="/all" class="text-sm text-hot no-underline hover:underline">Voir tout →</a>
      </div>

      {latest.length === 0 ? (
        <div class="text-center py-12 text-mute text-sm">Aucune annonce disponible.</div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {latest.map(listing => (
            <ListingCard listing={listing} showPrice />
          ))}
        </div>
      )}
    </section>

    <!-- In-content interstitial ad (CLS-safe) -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
      <AdUnit adSize="inline" />
    </div>

    <!-- Cities directory (internal linking) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 border-t border-line pt-12">
      <h2 class="font-display text-xl font-semibold text-in mb-6" style="font-family:var(--font-display)">Annonces par ville</h2>
      <div class="flex flex-wrap gap-2">
        {cities.map(city => (
          <a
            href={`/${DEFAULT_CATEGORY}/${city.toLowerCase().replace(/\s+/g, '-')}`}
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full border border-line bg-card text-sm font-medium text-in hover:bg-paper hover:border-hot/50 transition-colors no-underline"
          >
            {city}
          </a>
        ))}
      </div>
    </section>
  </main>

  <!-- Mobile sticky ad slot: CLS-safe, sticky at bottom -->
  <div class="mt-auto bg-card border-t border-line sticky bottom-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-1">
      <div class="w-full max-w-[320px]">
        <AdUnit adSize="mobile-sticky" />
      </div>
    </div>
  </div>

  <Footer />
</Layout>
