---
// Responsive ad unit with reserved space to prevent CLS
// adSize: 'atf' | 'inline' | 'mobile-sticky'
// CLS-safe min-height prevents layout collapse when ad loads
const adMap = {
  atf: { minHeight: '90px', aspectRatio: '320/50', label: 'ATF Leaderboard 320×50' },
  inline: { minHeight: '250px', aspectRatio: '400/250', label: 'In-content 400×250' },
  'mobile-sticky': { minHeight: '50px', aspectRatio: '320/50', label: 'Mobile Sticky 320×50' },
};

const { adSize = 'atf' } = Astro.props;
const sizeDef = adMap[adSize] || adMap.atf;
---

<!-- Ad slot: {sizeDef.label} — CLS-safe reserved space -->
<div
  class="ad-unit"
  data-ad-slot={adSize}
  data-ad-label={sizeDef.label}
  style={`min-height: ${sizeDef.minHeight}; display:flex; align-items:center; justify-content:center; background: var(--paper); border-radius: 18px; margin-bottom: 1rem; margin-top: ${adSize === 'atf' ? '1rem' : '0.5rem'}; ` + (adSize === 'atf' ? 'border-top: 4px solid var(--hot);' : '')}
>
  <div class="w-full" style={`aspect-ratio: ${sizeDef.aspectRatio}; max-width: 100%; ` + (adSize === 'inline' ? 'max-width: 400px;' : adSize === 'mobile-sticky' ? 'max-width: 320px;' : '')}>
    <span
      class="text-xs font-medium text-mute px-3 py-1 bg-paper rounded-full border border-line whitespace-nowrap"
      id={"ad-placeholder-" + adSize}
      aria-hidden="true"
    >
      {sizeDef.label} <span class="text-mute/60">(à remplacer par le SDK AdSense)</span>
    </span>
  </div>
</div>

<style>
  .ad-unit {
    width: 100%;
  }
</style>
